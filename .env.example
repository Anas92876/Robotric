# Copy to .env.local and adjust. All values are optional — defaults match robotrick.net today.
NEXT_PUBLIC_SITE_URL=https://www.robotrick.net
# The backend (server-side calls, and the target of the /api rewrite). Local backend: http://localhost:4889/api
NEXT_PUBLIC_API_BASE=https://robotrick-backend-production.up.railway.app/api
# Where the existing dashboard app lives (empty = same domain). Students go to /student, staff to /dashboard.
NEXT_PUBLIC_DASHBOARD_URL=
# The dashboard deployment this site forwards /student, /clo, /dash-assets… to (lib/dashboard.ts),
# e.g. https://robotrick-dashboard.vercel.app. In development it defaults to the Vite server, http://localhost:5173.
DASHBOARD_ORIGIN=
# Google Analytics 4 — current property is G-JZZ5RPMDBG (confirm with the owner before enabling)
NEXT_PUBLIC_GA_ID=

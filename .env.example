# Where the dashboard calls the backend. Default: /api on the same domain
# (the Vite dev server forwards it to http://localhost:4889; in production the
# public-site project rewrites /api to the backend). Change it only for a special setup.
# VITE_API_BASE=/api

# Google Maps browser key for place search on the Transport page.
# Without it, the page searches places with OpenStreetMap instead.
# VITE_GOOGLE_MAPS_KEY=

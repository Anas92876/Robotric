# Server
PORT=4889
NODE_ENV=development

# PostgreSQL — Supabase for now (Neon works the same way: just change the URL).
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Authentication (at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=7d

# Web client
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# File storage — Supabase Storage
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_KEY=service-role-key
SUPABASE_BUCKET=pdfs
SUPABASE_CLIENT_MEDIA_BUCKET=client-media
# Must be a PUBLIC bucket: website images are shown without login
SUPABASE_IMAGES_BUCKET=images

# Email (OTP codes). Without these, codes are printed to the log instead of sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Chrome/Edge used to render receipt PDFs locally (auto-detected if empty; Vercel uses its own)
# CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe

LOG_LEVEL=info

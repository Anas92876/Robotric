# Chromium is provided by the platform, not downloaded per install:
# nixpacks.toml installs it on Railway, and local development does not need it.
#
# This was previously written as PUPPETEER_SKIP_DOWNLOAD=true, which modern npm
# treats as an unknown *npm config* and does not pass to package install
# scripts — so every install still downloaded ~150MB of Chromium, and a partial
# download failed the whole install. The env- prefix... does not exist either,
# so the variable must be set in the environment instead. Documented here so the
# next person does not re-add the line that looks like it should work.
#
#   PUPPETEER_SKIP_DOWNLOAD=true npm ci
#
# See scripts.postinstall-note in package.json.
engine-strict=false
